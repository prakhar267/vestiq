# npm 10.9.2 has an arborist bug (`Cannot read properties of null (reading
# 'edgesOut')`) that trips on the vitest 4 / @cloudflare/vitest-pool-workers
# peer graph. Skipping strict peer resolution avoids it; the resolved tree is
# correct (vitest 4.1.10 satisfies the pool's ^4.1.0 peer requirement).
legacy-peer-deps=true
